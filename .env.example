# Server + worker only. Never expose to apps/web.
DATABASE_URL=postgresql://codem:codem@127.0.0.1:5432/codem
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change-me-to-a-long-random-string
JUDGE0_URL=http://127.0.0.1:2358
ANTHROPIC_API_KEY=
# AI provider: claude (default) or openai (any OpenAI-compatible API)
# Gemini: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
# Groq:   AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=openai/gpt-oss-120b
# Ollama: AI_BASE_URL=http://127.0.0.1:11434/v1                               AI_MODEL=qwen2.5-coder (no key)
AI_PROVIDER=claude
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WORKER_CONCURRENCY=4
# Web (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
# 1 = scripted fake AI (tests / no API key)
AI_FAKE=0
AI_PROVIDER=openai
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5-coder:7b
# Proxies in front of the server (1 behind Caddy, 0 locally)
TRUST_PROXY_HOPS=0
